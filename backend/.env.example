# Copy to .env (PowerShell: Copy-Item .env.example .env) and adjust.
# Real environment variables always override values in .env.
# Never commit .env. This project needs NO API keys and NO paid services.

APP_ENV=development
LOG_LEVEL=INFO

# SQLite file. Relative paths are resolved from the backend/ folder. It holds quest completions,
# notes, logged time and a summary of each plan (never coordinates).
DATABASE_PATH=data/touchgrass.db

# --- AI: a local open-weight model served by Ollama --------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Max seconds to wait for a generated plan (the first call also loads the model into memory).
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_TEMPERATURE=0.4
# Too low cuts the JSON off and triggers the labelled fallback.
OLLAMA_NUM_PREDICT=1800
OLLAMA_KEEP_ALIVE=10m
# Set to false to never contact the model: every plan then comes from the labelled non-AI fallback.
AI_ENABLED=true

# --- Browser access ----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Place discovery (OpenStreetMap data, live external services) -------------------------------
# overpass = search nearby places and look up typed place names (needs internet)
# none     = turn it off completely: no external requests are ever made, /api/places returns an honest 501
PLACES_PROVIDER=overpass
# Public OSM services require an identifying contact in the User-Agent. Use a URL or an email you own.
# Without it the app still runs but logs a warning, and the public servers may block you.
OSM_CONTACT=
# Overpass endpoints tried in order. Replace with your own instance for real traffic.
OVERPASS_URLS=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Per-client request limits (per minute) protecting the public services.
PLACES_RATE_PER_MINUTE=20
GEOCODE_RATE_PER_MINUTE=10
