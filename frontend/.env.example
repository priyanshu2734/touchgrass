# Copy to .env (PowerShell: Copy-Item .env.example .env). Everything here is PUBLIC: it is bundled into the
# browser code. Never put secrets in a VITE_ variable.

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# false (default) = use the real backend.
# true            = backend-free demo with built-in sample data. The UI labels it as a demo everywhere.
VITE_USE_MOCK=false

# --- Optional map settings --------------------------------------------------------------------
# Raster tile URL for the optional map view. The default is the public OpenStreetMap server, which is fine
# for development and light use but is NOT unlimited production infrastructure. For real traffic use a tile
# provider or your own server and change both lines. https://operations.osmfoundation.org/policies/tiles/
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Which service the "Directions" button opens: osm | google | apple
VITE_DIRECTIONS_PROVIDER=osm
